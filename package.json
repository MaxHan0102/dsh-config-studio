{
  "name": "dsh-config-studio",
  "version": "0.1.0",
  "type": "module",
  "description": "Visual editor for the active DSH profile's plugin configuration: browse every addressable Loader entry, render a form from its Config schema, and write non-volatile fields into the profile patch.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "configuration",
    "settings",
    "plugin-manager"
  ],
  "homepage": "https://github.com/MaxHan0102/dsh-config-studio#readme",
  "bugs": {
    "url": "https://github.com/MaxHan0102/dsh-config-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxHan0102/dsh-config-studio.git"
  },
  "license": "MIT",
  "author": "MaxHan0102",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "manifestVersion": 1
  },
  "icon": "./icon.svg"
}
